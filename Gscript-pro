                    </div>

                    <div class="bg-emerald-50/80 border border-emerald-100 rounded-lg p-3">
                        <label class="block text-[11px] font-mono tracking-wider uppercase text-emerald-700 mb-1">🤖 AI Formatting Tone</label>
                        <select id="aiTone" class="w-full bg-white border border-slate-200 rounded p-2 text-xs text-slate-800 focus:outline-none focus:border-emerald-500 font-mono transition-all">
